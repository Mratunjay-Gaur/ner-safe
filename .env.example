# ==============================================================================
# NER-SAFE - Landslide Early Warning & Operational Telemetry System
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in your project root and populate the values.
# Do NOT commit actual secrets or keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MONGODB_URI: Full MongoDB Atlas connection string (mongodb+srv://... or mongodb://...)
# Required for persistent production storage of incident reports, user accounts, and dispatch logs.
# Fallback: In-memory MongoDB Server is used if unconfigured or during local evaluation.
MONGODB_URI=

# MONGODB_DB_NAME: Target database name (default: NER-SAFE)
MONGODB_DB_NAME=NER-SAFE


# ------------------------------------------------------------------------------
# 2. AI & LARGE LANGUAGE MODEL (Google Gemini / GenAI)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API Key (from Google AI Studio / MakerSuite).
# Used by:
#   - /api/risk/explain: Real-time geological & meteorological landslide risk synthesis.
#   - /api/translate/emergency-alert: Dynamic multilingual translation of emergency broadcasts into 8 NER languages.
# (Also accepts GOOGLE_API_KEY, API_KEY, or GEMINI_KEY if already defined)
GEMINI_API_KEY=


# ------------------------------------------------------------------------------
# 3. MEDIA & EVIDENCE ASSET STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# Required for uploading citizen photo and video evidence in incident reporting (/api/incidents/upload-media).
# Obtain these from your Cloudinary Management Console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL & NOTIFICATIONS (Brevo / Sendinblue)
# ------------------------------------------------------------------------------
# BREVO_API_KEY: Brevo API v3 Key for transactional emails and SMTP relay.
# BREVO_SENDER_EMAIL: Verified sender email address in your Brevo account (e.g., alerts@yourdomain.com).
# BREVO_SENDER_NAME: Display sender name (default: "NER-SAFE Early Warning").
# Used by:
#   - Email OTP authentication for citizen & official login (/api/auth/send-email-otp).
#   - Urgent landslide community bulletin broadcasts (/api/alerts/broadcast-email).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NER-SAFE Early Warning


# ------------------------------------------------------------------------------
# 5. CITIZEN SMS DISPATCH & 2-FACTOR AUTH (2Factor.in)
# ------------------------------------------------------------------------------
# TWOFACTOR_API_KEY: 2Factor.in transactional SMS API key for Indian mobile numbers (+91).
# Used by:
#   - SMS OTP verification for citizen registration and login (/api/auth/send-sms-otp).
#   - High-priority SMS emergency broadcasts to vulnerable communities (/api/alerts/broadcast-sms).
TWOFACTOR_API_KEY=

# TWOFACTOR_SENDER_ID: Approved 6-character DLT Sender ID (default: NERSAF)
TWOFACTOR_SENDER_ID=NERSAF

# TWOFACTOR_TEMPLATE_NAME: Approved DLT transactional SMS template name (default: EmergencyAlert)
TWOFACTOR_TEMPLATE_NAME=EmergencyAlert


# ------------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# SESSION_SECRET / JWT_SECRET: Secret string used to sign and verify HMAC session tokens for user authentication.
# If omitted, a built-in development fallback key is used.
SESSION_SECRET=


# ------------------------------------------------------------------------------
# 7. ANDROID SMS SIM GATEWAY (Alternative / Local Hardware SMS Relay)
# ------------------------------------------------------------------------------
# Optional local Android SMS Gateway integration (for sending SMS via a physical SIM card app).
# Used by: /api/gateway/android/send-sms and background polling queue.
ANDROID_SMS_GATEWAY_URL=
ANDROID_SMS_GATEWAY_TOKEN=


# ------------------------------------------------------------------------------
# 8. EXTERNAL METEOROLOGY & MAPPING (Optional Overrides)
# ------------------------------------------------------------------------------
# WEATHER_API_KEY: Optional external weather provider API key.
# Note: NER-SAFE connects directly to the Open-Meteo Global WMO/ECMWF network (no key required by default).
WEATHER_API_KEY=

# MAPS_API_KEY / VITE_MAPS_API_KEY: Optional Google Maps Platform / custom tile layer API key.
# Note: NER-SAFE uses high-performance Leaflet with OpenStreetMap and CartoDB layers by default.
MAPS_API_KEY=


# ------------------------------------------------------------------------------
# 9. DEPLOYMENT & HOSTING ENVIRONMENT
# ------------------------------------------------------------------------------
# APP_URL: Public production URL where the application is deployed (e.g., https://nersafe.example.gov.in).
# Used to generate absolute verification and incident review links in emails and SMS messages.
APP_URL=

