# MONGODB_URI: MongoDB Atlas connection string for storing incident reports and user profiles
MONGODB_URI=

# CLOUDINARY CREDENTIALS: Required for photo and video storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# BREVO TRANSACTIONAL EMAIL: Required for sending OTP and Landslide Warning Emails
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# WEATHER_API_KEY: Optional external weather API key.
# Default: NER-SAFE connects to WMO/ECMWF global meteorological data service (Open-Meteo).
WEATHER_API_KEY=

# MAPS_API_KEY: Optional Maps API key for Google Maps Platform / Map tiles.
MAPS_API_KEY=

# GEMINI_API_KEY: Required for future SIH26001 AI/ML early warning & prediction stages.
GEMINI_API_KEY=

# 2FACTOR SMS API: Required for sending SMS OTP and SMS emergency warnings
TWOFACTOR_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=
